{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@webgpu/types", "vite/client"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src", "scripts"]
}
