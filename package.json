{
  "name": "pushminer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "sim": "esbuild scripts/sim.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sim/sim.mjs --log-level=warning && node node_modules/.cache/sim/sim.mjs",
    "sim:check": "esbuild scripts/sim-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sim/sim-check.mjs --log-level=warning && node node_modules/.cache/sim/sim-check.mjs",
    "bench": "esbuild scripts/physics-bench.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sim/physics-bench.mjs --log-level=warning && node node_modules/.cache/sim/physics-bench.mjs",
    "fuzz": "esbuild scripts/fuzz.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sim/fuzz.mjs --log-level=warning && node node_modules/.cache/sim/fuzz.mjs",
    "determinism": "esbuild scripts/determinism-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sim/determinism.mjs --log-level=warning && node node_modules/.cache/sim/determinism.mjs",
    "leaks": "esbuild scripts/leak-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sim/leaks.mjs --log-level=warning && node node_modules/.cache/sim/leaks.mjs",
    "leaks:check": "esbuild scripts/leak-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sim/leaks.mjs --log-level=warning && node node_modules/.cache/sim/leaks.mjs --minutes 20",
    "balance": "esbuild scripts/balance.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sim/balance.mjs --log-level=warning && node node_modules/.cache/sim/balance.mjs",
    "balance:check": "esbuild scripts/balance.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sim/balance.mjs --log-level=warning && node node_modules/.cache/sim/balance.mjs --check",
    "smoke": "playwright test",
    "look": "playwright test smoke/look.spec.ts",
    "look:update": "playwright test smoke/look.spec.ts --update-snapshots",
    "check:quick": "prettier --check . --log-level warn && npm run --silent typecheck && eslint . && vitest run --reporter dot",
    "check": "npm run --silent check:quick && npm run --silent fuzz && npm run --silent determinism && npm run --silent leaks:check && npm run --silent sim:check && npm run --silent balance:check && npm run --silent bench && npm run --silent smoke",
    "prepare": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "artshape-render": "github:onion2k/artshape-render#v0.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/pngjs": "^6.0.5",
    "@webgpu/types": "^0.1.72",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  }
}
