{
  "name": "pushminer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim": "esbuild scripts/sim.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sim/sim.mjs --log-level=warning && node node_modules/.cache/sim/sim.mjs"
  },
  "dependencies": {
    "artshape-render": "github:onion2k/artshape-render#v0.16.0"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.72",
    "esbuild": "^0.25.12",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
